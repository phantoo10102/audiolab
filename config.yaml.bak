# ============================================================
# Audio Lab System Configuration
# ============================================================
# [IMPORTANT] This file contains SYSTEM DEFAULTS only.
# Your personal settings (from Settings UI) are saved in:
#    → data/config/user_settings.yaml (auto-created)
# Priority: user_settings.yaml OVERRIDES values in this file
# To manually edit settings:
#    1. Go to Settings tab in app (recommended)
#    2. OR edit data/config/user_settings.yaml directly
# DO NOT edit this file unless changing system defaults.
# ============================================================

audio:
  export:
    default_format: "mp3"
    default_bitrate: "320k"
    format_options:
      - "mp3"
      - "wav"
      - "flac"
    bitrate_options:
      - "128k"
      - "192k"
      - "256k"
      - "320k"

processing:
  denoise:
    default_strength: 0.5
    reduce_noise_db: 12.0
    default_method: "auto"
  
  trim_silence:
    silence_thresh_db: -40.0
    min_silence_len_ms: 400
    keep_silence_ms: 150
    
  separation:
    default_model: "htdemucs"
    available_models:
      - "htdemucs"
      - "htdemucs_ft"
      - "mdx_extra"

system:
  jobs:
    timeout_seconds: 300
    max_workers: 4
    
  history:
    max_steps: 10
    cleanup_interval: 10
    
  cache:
    waveform_ttl: 3600

  # [FIX BUG-019] Cleanup Settings
  cleanup:
    enabled: true
    max_age_hours: 24      # Xóa file cũ hơn 24 giờ
    max_size_mb: 1000      # Giới hạn thư mục temp là 1GB